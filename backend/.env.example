# Copy to .env and adjust before `docker compose up`

# --- Postgres ---
POSTGRES_USER=ibvap
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ibvap
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth / JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Service-to-service (M2M) shared secret ---
INTERNAL_SERVICE_TOKEN=change_me_to_a_long_random_internal_secret

# --- Bootstrap admin (created on first Auth Service startup if no users exist) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# --- Media storage ---
MEDIA_ROOT=/data/media

# --- CORS (Phase 2 M11: frontend now runs on a separate origin) ---
# Exact origin the frontend is served from -- the gateway reflects this back
# on API responses only when the request's Origin header matches it exactly.
# Vite's default dev server origin is the default here; set to the real
# deployed frontend origin (e.g. https://app.example.com) in production.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Grafana (M24 security review: docker-compose.yml falls back to the
# well-known default "admin" if this is unset -- always set it) ---
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password
